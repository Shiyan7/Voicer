{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client-preview",
      "cwd": "client",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "serve",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "client-dev",
      "cwd": "client",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "voicer-server",
      "cwd": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "port": 1488
    },
    {
      "name": "client-chat-verify",
      "cwd": "client",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_GRAPHQL_API_URL=http://localhost:1489/graphql",
        "npx",
        "vite",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    }
  ]
}
