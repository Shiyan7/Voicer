{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-delete",
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "x-apple.systempreferences:*" }]
    },
    "opener:allow-reveal-item-in-dir",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": ["$APPDATA/recordings/*", "$APPDATA/recordings/**/*", "$DOWNLOAD/*"]
    }
  ]
}
